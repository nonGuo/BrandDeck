# ---- 临时产物 / 构建缓存 -------------------------------------------------
# 测试与调试产物（渲染出的 PNG、临时 pptx、一次性脚本）
.tmp/
**/.tmp/
.dsh-office-*/
*.log
render-dir*.txt
crop-*.png

# ---- 依赖 -----------------------------------------------------------------
node_modules/
**/node_modules/
.pnpm-store/
.pnpm-debug.log*

# ---- 本地调研副本 ---------------------------------------------------------
# 从 app.asar 解包出来的 DSH 源码（412 MB，可再生，仅供查 API 用）
.dsh-src/

# ---- 运行期数据 -----------------------------------------------------------
# 插件默认数据目录是 $DSH_HOME/branddeck，万一有人指到仓库里
branddeck-data/
# 面板/工具导出的临时导出目录
exports/
# 编译导出的默认目录 `<cwd>/branddeck/<deckId>.pptx`（注意不要连带忽略插件目录本身）
/branddeck/
plugins/branddeck/branddeck/

# ---- 编辑器 / 操作系统 ----------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---- 其他 ----------------------------------------------------------------
*.tsbuildinfo
coverage/

# ---- 本地参考资料（不入库）-----------------------------------------------
大纲及详细文字版生成逻辑.md
排版及内容组织参考方案.md

# ---- 插件/技能的一次性产物 ------------------------------------------------
# archify 技能生成的架构图草稿目录
.archify/
