{
  "name": "@local/dsh-branddeck",
  "version": "0.1.0",
  "private": true,
  "description": "BrandDeck: extract brand design tokens from a corporate .pptx template, author 1280x720 card decks, and compile them into native editable PowerPoint files.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "src/**/*.js",
    "locale/*.json",
    "icon.svg",
    "assets/**/*"
  ],
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "fast-xml-parser": "^5.2.5",
    "jszip": "^3.10.1",
    "pptxgenjs": "^4.0.1",
    "zod": "^4.1.12"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
